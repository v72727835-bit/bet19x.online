        <style>
            @keyframes fxCatScroll {
                0%   { transform: translateX(0); }
                100% { transform: translateX(-50%); }
            }
            .fx-cat-track {
                animation: fxCatScroll 40s linear infinite;
                width: max-content;
                display: flex;
                gap: 24px;
            }
            .fx-cat-track:hover {
                animation-play-state: paused;
            }
            .fx-cat-item {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                flex-shrink: 0;
                width: 96px;
                text-decoration: none;
            }
            .fx-cat-tile {
                position: relative;
                overflow: hidden;
                width: 84px;
                height: 84px;
                border-radius: 26px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: linear-gradient(145deg, #FF4F9A 0%, #FF1F4D 100%);
                box-shadow: 0 6px 18px rgba(255,31,77,0.35), inset 0 1px 0 rgba(255,255,255,0.35);
                transition: transform .25s ease, box-shadow .25s ease;
            }
            .fx-cat-tile span {
                font-size: 42px;
                line-height: 1;
                filter: drop-shadow(0 2px 3px rgba(0,0,0,0.25));
            }
            .fx-cat-tile:hover {
                transform: translateY(-5px) scale(1.05);
                box-shadow: 0 12px 28px rgba(255,79,154,0.45), inset 0 1px 0 rgba(255,255,255,0.4);
            }
            .fx-cat-tile::after {
                content: "";
                position: absolute;
                top: 0; left: -150%;
                width: 55%; height: 100%;
                background: linear-gradient(120deg, transparent, rgba(255,255,255,0.55), transparent);
                transform: skewX(-20deg);
                animation: fxShineSweep 3.2s ease-in-out infinite;
            }
            @keyframes fxShineSweep {
                0%   { left: -150%; }
                55%  { left: 150%; }
                100% { left: 150%; }
            }
            .fx-cat-name {
                color: #F4F3FA;
                font-family: 'Rajdhani', sans-serif;
                font-weight: 600;
                font-size: 12px;
                text-align: center;
            }

            /* Sirf phone view (max-width 640px) ke liye chhota size */
            @media (max-width: 640px) {
                .fx-cat-track { gap: 14px; }
                .fx-cat-item { width: 62px; }
