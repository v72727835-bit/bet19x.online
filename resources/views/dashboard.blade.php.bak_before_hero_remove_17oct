<script>
(function(){
const root=document.getElementById('demo-showcase');if(!root)return;
const cards=Array.from(root.querySelectorAll('.studio-card'));const filters=Array.from(root.querySelectorAll('.studio-filter'));const search=root.querySelector('#studio-search');const dialog=root.querySelector('#studio-dialog');let active='All';let opener;
function render(){let count=0;const q=search.value.trim().toLocaleLowerCase();cards.forEach(card=>{const categories=card.dataset.categories.split('|');const matches=active==='All'||(active==='HOT'?card.dataset.hot==='1':categories.includes(active));card.hidden=!(matches&&card.dataset.name.toLocaleLowerCase().includes(q));if(!card.hidden)count++});root.querySelector('#studio-count').textContent=count+' of '+cards.length+' studio profiles';root.querySelector('#studio-empty').hidden=count!==0;}
filters.forEach(button=>button.addEventListener('click',()=>{active=button.dataset.filter;filters.forEach(b=>b.setAttribute('aria-pressed',String(b===button)));render()}));search.addEventListener('input',render);
cards.forEach(card=>{const img=card.querySelector('img');if(img){img.addEventListener('error',()=>img.hidden=true);if(img.complete&&img.naturalWidth===0)img.hidden=true;}card.addEventListener('click',()=>{opener=card;root.querySelector('#studio-dialog-title').textContent=card.dataset.name;root.querySelector('#studio-dialog-category').textContent=card.dataset.categories.split('|').filter(Boolean).join(' · ')||'Studio profile';dialog.showModal()})});root.querySelector('#studio-dialog-close').addEventListener('click',()=>dialog.close());dialog.addEventListener('close',()=>opener&&opener.focus());render();
})();
</script>
